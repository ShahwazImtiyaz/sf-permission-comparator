{
  "name": "sf-permission-compare",
  "version": "1.0.0",
  "type": "module",
  "bin": "server.cjs",
  "scripts": {
    "dev:server": "node server.js",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "node server.js",
    "package:mac": "npm run build && pkg . --target node18-macos-arm64 --output dist-bin/sf-compare-mac",
    "package:mac-x64": "npm run build && pkg . --target node18-macos-x64 --output dist-bin/sf-compare-mac-x64",
    "package:win": "npm run build && pkg . --target node18-win-x64 --output dist-bin/sf-compare-win.exe",
    "package:all": "npm run build && pkg . --targets node18-macos-arm64,node20-macos-x64,node18-win-x64 --output dist-bin/sf-compare",
    "package:zip": "node scripts/build-zip.js",
    "package:mac-zip": "npm run package:mac && node scripts/build-zip.js",
    "package:win-zip": "npm run package:win && node scripts/build-zip.js",
    "package:all-zip": "npm run package:all && node scripts/build-zip.js",
    "package:slim": "npm run build && node scripts/build-slim-zip.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "pkg": "^5.8.1",
    "vite": "^5.0.0"
  },
  "pkg": {
    "scripts": ["server.cjs", "chrome-session.cjs"],
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-macos-arm64",
      "node18-win-x64"
    ]
  }
}
